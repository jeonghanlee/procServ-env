#
.DEFAULT_GOAL := help

.PHONY: help default init distclean deinit

# # help is defined in 
# # https://gist.github.com/rcmachado/af3db315e31383502660
help:
	$(info --------------------------------------- )	
	$(info Make Targets)
	$(info --------------------------------------- )
	$(QUIET) awk '/^[a-zA-Z\-\_0-9]+:/ {            \
	  nb = sub( /^## /, "", helpMsg );              \
	  if(nb == 0) {                                 \
	    helpMsg = $$0;                              \
	    nb = sub( /^[^:]*:.* ## /, "", helpMsg );   \
	  }                                             \
	  if (nb)                                       \
	    print  $$1 "\t" helpMsg;                    \
	}                                               \
	{ helpMsg = $$0 }'                              \
	$(MAKEFILE_LIST) | column -ts:


default: help

.PHONY: init deinit distclean check-tools

## Verify required build tools are available
check-tools:
	$(QUIET) bash $(TOP)/configure/check-tools.bash

## Clone Source
init: check-tools
	$(call gitclone2,$(SRC_GITURL),$(SRC_PATH),$(SRC_TAG))

## Clean Source
distclean:
	$(call distclean, $(SRC_PATH))

## Remove cloned source (alias of distclean)
deinit: distclean

.PHONY: build conf all github

## Build source
build:
	$(QUIET) $(MAKE) -C $(SRC_PATH)

## Configure, build, and install in one go
all: conf build install

## Clone, configure, build, and install (CI entry)
github: init conf build
	$(QUIET) sudo $(MAKE) install

